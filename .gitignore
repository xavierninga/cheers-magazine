# ==========================================
# Cheers Magazine — .gitignore
# ==========================================

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
out/
build/

# Environment — NEVER commit these
.env.local
.env.*.local

# Temp uploads
tmp/
uploads/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp

# Testing
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Vercel
.vercel/
