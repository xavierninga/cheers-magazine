# =============================================
# CHEERS MAGAZINE - Environment Variables
# =============================================
# Copy this file to .env.local for development
# NEVER commit .env.local to git

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Cheers Magazine
NEXT_PUBLIC_APP_ENV=development

# ---- Feature Flags ----
NEXT_PUBLIC_FEATURE_SOUNDS=true
NEXT_PUBLIC_FEATURE_ANIMATIONS=true
NEXT_PUBLIC_FEATURE_ANTI_PIRACY=false
NEXT_PUBLIC_FEATURE_WATERMARK=true
NEXT_PUBLIC_FEATURE_FULLSCREEN=true
NEXT_PUBLIC_FEATURE_DEBUG_MODE=true
NEXT_PUBLIC_FEATURE_PAYMENTS=false

# ---- Debug ----
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_SHOW_FPS=false
NEXT_PUBLIC_LOG_LEVEL=verbose

# ---- Storage ----
# For PDF uploads & images
STORAGE_PROVIDER=local
# AWS S3 (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=

# ---- Payment (future) ----
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Analytics (future) ----
# NEXT_PUBLIC_GA_ID=
